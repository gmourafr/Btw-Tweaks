# Porta em que o servidor vai rodar (a maioria dos hosts como Railway/Render define isso sozinho)
PORT=3000

# Senha usada para acessar o painel de admin (/admin.html)
# Troque por uma senha forte antes de colocar no ar
ADMIN_PASSWORD=troque-esta-senha

# URL publica onde o site vai ficar no ar, sem barra no final.
# Em producao: https://seu-dominio.com.br (ou a URL que o Railway/Render te dao)
APP_BASE_URL=http://localhost:3000

# Credenciais do Mercado Pago (Suas integracoes > Credenciais, no painel de
# desenvolvedores). Use as credenciais de TESTE pra validar o fluxo antes de
# trocar pelas de producao.
MP_ACCESS_TOKEN=

# Chave secreta da notificacao webhook (Suas integracoes > Webhooks > chave
# secreta). Opcional, mas recomendado: sem ela o servidor ainda funciona,
# so nao confere se a notificacao realmente veio do Mercado Pago.
MP_WEBHOOK_SECRET=
